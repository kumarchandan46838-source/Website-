<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_futuristic_card"
    android:orientation="vertical"
    android:padding="14dp"
    android:layout_marginBottom="10dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="6dp">

        <TextView
            android:id="@+id/tv_memory_category"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="FACT"
            android:textSize="10sp"
            android:textStyle="bold"
            android:textColor="@color/neon_pink"
            android:background="@drawable/bg_card_elevated"
            android:paddingHorizontal="8dp"
            android:paddingVertical="2dp"
            android:layout_marginEnd="8dp" />

        <TextView
            android:id="@+id/tv_memory_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Favorite Song"
            android:textStyle="bold"
            android:textColor="@color/text_primary"
            android:textSize="14sp" />

        <ImageView
            android:id="@+id/btn_delete_memory"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@drawable/ic_stop"
            android:tint="@color/color_error"
            android:contentDescription="Delete" />
    </LinearLayout>

    <TextView
        android:id="@+id/tv_memory_content"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="User loves listening to Kesariya in Hindi."
        android:textColor="@color/text_secondary"
        android:textSize="13sp" />

</LinearLayout>
