<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_dark">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:padding="24dp">

        <ImageView
            android:layout_width="80dp"
            android:layout_height="80dp"
            android:src="@drawable/ic_robot"
            android:layout_marginBottom="16dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Yesmin AI"
            android:textSize="26sp"
            android:textStyle="bold"
            android:textColor="@color/neon_cyan" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="v1.0.0 • Female Companion &amp; JARVIS Engine"
            android:textSize="13sp"
            android:textColor="@color/neon_pink"
            android:layout_marginBottom="24dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Yesmin AI combines emotional intelligence, female companion warmth, and JARVIS-level phone automation. Powered by Google Gemini AI, Android SpeechRecognizer, TextToSpeech, and Room persistent memory."
            android:textSize="14sp"
            android:textColor="@color/text_secondary"
            android:lineSpacingExtra="4dp"
            android:gravity="center"
            android:layout_marginBottom="24dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Developed for standalone Android &amp; Termux builds."
            android:textSize="12sp"
            android:textColor="@color/text_muted" />

    </LinearLayout>
</androidx.core.widget.NestedScrollView>
